# TradeCore API — Environment Variables
# Copy to .env and fill in values
# In production all values come from AWS Secrets Manager

# App
NODE_ENV=development
PORT=4000
APP_VERSION=1.0.0

# Database — provided by Cloud team from RDS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tradecore
DB_USER=tradecore
DB_PASSWORD=REPLACE_WITH_PASSWORD
DB_SSL=false
DB_POOL_MAX=10

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3001

# AWS — injected by ECS task role, do not hardcode
AWS_REGION=af-south-1
S3_BUCKET=REPLACE_WITH_BUCKET_NAME

# Logging
LOG_LEVEL=info
